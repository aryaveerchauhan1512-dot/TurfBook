# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Brevo (Sendinblue) Transactional Email API settings for OTP delivery
# Generate an API key from: Brevo Dashboard > SMTP & API > API Keys
BREVO_API_KEY="xkeysib-..."
# The email address registered and verified in your Brevo account
BREVO_SENDER_EMAIL="turfbook.support@gmail.com"
BREVO_SENDER_NAME="TurfBook Verification"

# ==============================================================================
# FIREBASE CLOUD MESSAGING (FCM) - BROWSER PUSH NOTIFICATIONS
# ==============================================================================
# Client-Side Firebase Configuration (Firebase Console > Project Settings > General > Your Apps > Web App)
VITE_FIREBASE_API_KEY="AIzaSyDZjW74kKPZO-qesqpY158JBBBaMalb808"
VITE_FIREBASE_PROJECT_ID="turfbook-7b4ec"
VITE_FIREBASE_MESSAGING_SENDER_ID="190824969167"
VITE_FIREBASE_APP_ID="1:190824969167:web:7ec6d681aa3a7e9d8c18ba"
VITE_FIREBASE_AUTH_DOMAIN="turfbook-7b4ec.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="turfbook-7b4ec.firebasestorage.app"

# Web Push Certificate / VAPID Key (Firebase Console > Project Settings > Cloud Messaging > Web configuration > Web Push certificates)
VITE_FIREBASE_VAPID_KEY="BEhTARgxwOzUZZ_GA0lcOugrMxBQXGNeTPmAFiMm6LXB9gzhzWa_3ch-bka_xf9y6RLfx4iGpufWkG6eTTU8Aw0"

# Server-Side Firebase Admin SDK Credentials (Used to dispatch push notifications on booking requests)
# Option 1: Full JSON string of service account key (Firebase Console > Project Settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"turfbook-7b4ec","private_key":"...","client_email":"..."}'

# Option 2: Individual variables (alternative to full JSON string)
FIREBASE_PROJECT_ID="turfbook-7b4ec"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

